<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="22dp"
        android:paddingTop="20dp"
        android:paddingBottom="28dp"
        android:animateLayoutChanges="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="24dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/dashboard_title"
                android:textSize="34sp"
                android:textStyle="bold"
                android:letterSpacing="0.01"
                android:textColor="@color/text_primary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/dashboard_subtitle"
                android:textSize="15sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="20dp"
                android:lineSpacingMultiplier="1.2" />

            <Button
                android:id="@+id/btnAgregarMedicamento"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_button_primary"
                android:text="@string/btn_add_medication"
                android:textAllCaps="false"
                android:textColor="@color/surface_color"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnAgregarRecordatorio"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_button_primary"
                android:text="@string/btn_add_reminder"
                android:textAllCaps="false"
                android:textColor="@color/surface_color"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnAgregarCita"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_button_primary"
                android:text="@string/btn_add_appointment"
                android:textAllCaps="false"
                android:textColor="@color/surface_color"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnVerHistorial"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_button_secondary"
                android:text="@string/btn_view_history"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnBuscarOnline"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_button_secondary"
                android:text="@string/btn_lookup_medicine"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnVerFarmacias"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_button_secondary"
                android:text="@string/btn_nearby_pharmacies"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnActivarSensores"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_button_secondary"
                android:text="@string/btn_enable_protection"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/section_today_meds"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:id="@+id/containerMedicamentos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:animateLayoutChanges="true"
            android:layout_marginBottom="24dp">
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/section_summary"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tvInfo1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/loading_meds"
            android:textSize="15sp"
            android:textColor="@color/text_primary"
            android:paddingHorizontal="18dp"
            android:paddingVertical="16dp"
            android:background="@drawable/bg_card"
            android:layout_marginBottom="14dp"
            android:lineSpacingMultiplier="1.3" />

        <TextView
            android:id="@+id/tvInfo2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/loading_reminders"
            android:textSize="15sp"
            android:textColor="@color/text_primary"
            android:paddingHorizontal="18dp"
            android:paddingVertical="16dp"
            android:background="@drawable/bg_card"
            android:layout_marginBottom="14dp"
            android:lineSpacingMultiplier="1.3" />

        <TextView
            android:id="@+id/tvInfo3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/loading_history"
            android:textSize="15sp"
            android:textColor="@color/text_primary"
            android:paddingHorizontal="18dp"
            android:paddingVertical="16dp"
            android:background="@drawable/bg_card"
            android:layout_marginBottom="14dp"
            android:lineSpacingMultiplier="1.3" />

    </LinearLayout>

</ScrollView>
